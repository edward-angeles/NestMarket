
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".EditBuyerProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Back"
            android:textColor="@color/primary_green"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textColor="@color/primary_green"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtProfileInitial"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_accent_button"
            android:gravity="center"
            android:text="J"
            android:textColor="@color/card_white"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnChangePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="Change Photo"
            android:textColor="@color/primary_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="Full Name"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your full name"
            android:paddingHorizontal="16dp"
            android:text="John Smith"
            tools:text="John Smith"
            android:textColor="@color/main_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="14sp"
            android:inputType="textPersonName" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Email Address"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your email"
            android:paddingHorizontal="16dp"
            android:text="john@email.com"
            tools:text="john@email.com"
            android:textColor="@color/main_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="14sp"
            android:inputType="textEmailAddress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Phone Number"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your phone number"
            android:paddingHorizontal="16dp"
            android:text="(514) 555-0123"
            tools:text="(514) 555-0123"
            android:textColor="@color/main_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="14sp"
            android:inputType="phone" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Location"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your location"
            android:paddingHorizontal="16dp"
            android:text="Montreal, QC"
            tools:text="Montreal, QC"
            android:textColor="@color/main_text"
            android:textColorHint="@color/secondary_text"
            android:textSize="14sp"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/card_white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
