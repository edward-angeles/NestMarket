<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NestMarket"
            android:textSize="26sp"
            android:textColor="@color/primary_green"
            android:fontFamily="serif"/>

        <!-- Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Create Account"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/main_text"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Join our community of furniture lovers"
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"/>

        <!-- Full Name Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Full Name"
            android:textSize="14sp"
            android:textColor="@color/main_text"/>

        <!-- Full Name Input -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:hint="Enter your full name"/>

        <!-- Email Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email Address"
            android:textSize="14sp"
            android:textColor="@color/main_text"/>

        <!-- Email Input -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"/>

        <!-- Password Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Password"
            android:textSize="14sp"
            android:textColor="@color/main_text"/>

        <!-- Password Input -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:hint="Create a password"
            android:inputType="textPassword"/>

        <!-- Confirm Password Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirm Password"
            android:textSize="14sp"
            android:textColor="@color/main_text"/>

        <!-- Confirm Password Input -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:hint="Confirm your password"
            android:inputType="textPassword"/>

        <!-- Account Type Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="I want to join as a:"
            android:textColor="@color/main_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Buyer and Seller Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <!-- Buyer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyer"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"

                android:text="Buyer"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                app:backgroundTint="@color/card_white"
                app:cornerRadius="11dp"

                app:icon="@drawable/ic_buyer"
                app:iconTint="@color/primary_green"
                app:iconSize="22dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart" />

            <!-- Seller -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeller"
                android:layout_width="0dp"
                android:layout_height="65dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"

                android:text="Seller"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"

                app:backgroundTint="@color/card_white"
                app:cornerRadius="11dp"

                app:icon="@drawable/ic_seller"
                app:iconTint="@color/primary_green"
                app:iconSize="22dp"
                app:iconPadding="8dp"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Create Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="Create Account"
            android:textColor="@color/card_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary_green"
            app:cornerRadius="11dp"
             />

        <!-- Login Link -->
        <TextView
            android:id="@+id/tvLogInRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Already have an account? Log in"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/secondary_text"
             />

    </LinearLayout>

</ScrollView>
