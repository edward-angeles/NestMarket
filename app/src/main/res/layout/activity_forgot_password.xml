<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="NestMarket"
            android:textSize="26sp"
            android:textColor="@color/primary_green"
            android:fontFamily="serif" />

        <!-- Back to sign in -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToSignIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="&#8592;  Back to sign in"
            android:textSize="13sp"
            android:textColor="@color/primary_green"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/secondary_text"
            app:strokeWidth="1dp"
            app:cornerRadius="100dp"
            />

        
        <!-- Heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Forgot password"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/main_text" />

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Enter the email you used to create your account.\nWe&apos;ll help you get back in."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/main_text" />

        <!-- Email Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Email Address"
            android:textSize="14sp"
            android:textColor="@color/main_text" />

        <!-- Email Input -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:hint="you@example.com"
            android:textColorHint="@color/secondary_text"
            android:textColor="@color/main_text"
            android:inputType="textEmailAddress" />

        <!-- Send reset link -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendResetLink"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="22dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="send reset link &#8594;"
            android:textColor="@color/card_white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:letterSpacing="0"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary_green"
            app:cornerRadius="11dp"
           />

    </LinearLayout>

</ScrollView>
