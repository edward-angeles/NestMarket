<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="4dp">

    <!-- PRODUCT IMAGE AND FAVORITE ICON -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="130dp">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_product_image"
            android:scaleType="centerCrop"
            android:contentDescription="Furniture product image"/>

        <ImageView
            android:id="@+id/btnFavorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_favorite"
            android:tint="@color/primary_green"
            android:contentDescription="Add to wishlist"/>

    </FrameLayout>

    <!-- PRODUCT NAME -->
    <TextView
        android:id="@+id/txtProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Lounge Chair"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/main_text"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- PRODUCT PRICE -->
    <TextView
        android:id="@+id/txtProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="$55"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/primary_green"/>

    <!-- PRODUCT LOCATION -->
    <TextView
        android:id="@+id/txtProductLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mile End · 1.2 km"
        android:textSize="10sp"
        android:textColor="@color/secondary_text"
        android:maxLines="1"
        android:ellipsize="end"/>

</LinearLayout>
